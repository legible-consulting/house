---
// The desk's shell: one header with the links the role has, the user and sign-out, one
// footer that names the build. Plain HTML forms; no client script.
interface Props {
  title?: string;
}
const { title = "Desk" } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const links =
  user?.role === "jamie"
    ? [
        ["/", "Clients"],
        ["/pool", "Pool"],
      ]
    : user?.role === "salesman"
      ? [["/pool", "Pool"]]
      : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { margin: 0 auto; max-width: 64rem; padding: 1rem; }
      header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; margin-bottom: 1rem; }
      header h1 { margin: 0; font-size: 1.4rem; }
      header nav a { margin-right: 0.8rem; }
      header nav a[aria-current="page"] { font-weight: 600; }
      header .who { margin-left: auto; font-size: 0.9rem; opacity: 0.8; display: flex; gap: 0.6rem; align-items: baseline; }
      table { border-collapse: collapse; width: 100%; }
      th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #8884; vertical-align: top; }
      .wrap { overflow-x: auto; }
      .counts { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 1rem; padding: 0; list-style: none; }
      .counts li { border: 1px solid #8884; border-radius: 0.4rem; padding: 0.3rem 0.6rem; }
      .counts b { font-size: 1.2rem; margin-right: 0.3rem; }
      form.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.6rem 1rem; }
      form.grid label { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.9rem; }
      form.grid label.wide { grid-column: 1 / -1; }
      input, select, textarea, button { font: inherit; padding: 0.3rem 0.4rem; }
      form.inline { display: inline-flex; gap: 0.3rem; }
      .error { color: #c33; }
      .muted { opacity: 0.7; }
      footer { margin-top: 1.5rem; font-size: 0.85rem; opacity: 0.7; }
    </style>
  </head>
  <body>
    <header>
      <h1>Desk</h1>
      <nav>
        {links.map(([href, label]) => <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>)}
      </nav>
      {user && (
        <div class="who">
          <span>{user.name || user.email} · {user.role}</span>
          <form method="post" action="/sign-out" class="inline"><button>Sign out</button></form>
        </div>
      )}
    </header>
    <main><slot /></main>
    <footer>built {__BUILD_TIME__} from {__BUILD_COMMIT__}</footer>
  </body>
</html>
