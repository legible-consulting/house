---
// The pool: a salesman's own prospects, Jamie's view of all of them. Add a prospect, move a
// status in place, open one for the rest. "Ready for Jamie" lives on the prospect's page.
import Desk from "../../layouts/Desk.astro";
import { STATUSES, fieldsFrom, insertProspect, isStatus, prospectsFor, setStatus, prospectFor } from "../../lib/db";

const user = Astro.locals.user!;
if (user.role === "client") return Astro.redirect("/", 303);

let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  try {
    const action = form.get("action");
    if (action === "add") {
      const id = await insertProspect(user.id, fieldsFrom(form));
      return Astro.redirect(`/pool/${id}`, 303);
    }
    if (action === "status") {
      const id = String(form.get("id") ?? "");
      const status = form.get("status");
      if (!isStatus(status) || status === "ready for Jamie") throw new Error("Not a status to move to here.");
      if (!(await prospectFor(user, id))) throw new Error("Not your prospect.");
      await setStatus(id, status);
      return Astro.redirect("/pool", 303);
    }
    throw new Error("Unknown action.");
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const rows = await prospectsFor(user);
const moves = STATUSES.filter((s) => s !== "ready for Jamie");
---
<Desk title="Pool · Desk">
  <h2>Pool</h2>
  {error && <p class="error">{error}</p>}
  <div class="wrap">
    <table>
      <thead>
        <tr>
          <th>Company</th><th>Contact</th><th>Status</th><th>Next action</th>
          {user.role === "jamie" && <th>Salesman</th>}
          <th>Updated</th>
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 && <tr><td colspan="6" class="muted">No prospects yet.</td></tr>}
        {rows.map((p) => (
          <tr>
            <td><a href={`/pool/${p.id}`}>{p.company}</a></td>
            <td>{p.contact_name}{p.email ? ` · ${p.email}` : ""}</td>
            <td>
              <form method="post" class="inline">
                <input type="hidden" name="action" value="status" />
                <input type="hidden" name="id" value={p.id} />
                <select name="status">
                  {moves.map((s) => <option value={s} selected={s === p.status}>{s}</option>)}
                  {p.status === "ready for Jamie" && <option value="ready for Jamie" selected>ready for Jamie</option>}
                </select>
                <button>Move</button>
              </form>
            </td>
            <td>{p.next_action}</td>
            {user.role === "jamie" && <td>{p.salesman_name || p.salesman_email}</td>}
            <td>{String(p.updated_at).slice(0, 10)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>Add a prospect</h3>
  <form method="post" class="grid">
    <input type="hidden" name="action" value="add" />
    <label>Company <input name="company" required /></label>
    <label>Contact name <input name="contact_name" /></label>
    <label>Email <input type="email" name="email" /></label>
    <label>Language <input name="language" placeholder="pt-PT" /></label>
    <label>Source <input name="source" placeholder="referral, LinkedIn, event" /></label>
    <label>Next action <input name="next_action" /></label>
    <label class="wide">Notes <textarea name="notes" rows="3"></textarea></label>
    <div><button>Add</button></div>
  </form>
</Desk>
