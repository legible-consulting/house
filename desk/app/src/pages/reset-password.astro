---
// Sets a new password from the token in the emailed link. Neon Auth appends ?token=... to the
// redirect URL, or ?error=INVALID_TOKEN when the link is stale. A success goes back to
// sign-in with a notice.
import Desk from "../layouts/Desk.astro";
import { authFor } from "../lib/auth";

const token = Astro.url.searchParams.get("token") ?? "";
const linkError = Astro.url.searchParams.get("error");
let error = linkError ? "This link is not valid any more. Ask for a new one." : "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const t = String(form.get("token") ?? "");
  const password = String(form.get("password") ?? "");
  const again = String(form.get("again") ?? "");
  if (!t) {
    error = "The link is missing its token. Ask for a new one.";
  } else if (password.length < 8) {
    error = "Use at least 8 characters.";
  } else if (password !== again) {
    error = "The two passwords differ.";
  } else {
    const { error: e } = await authFor(Astro).resetPassword({ newPassword: password, token: t });
    if (e) {
      error = e.message ?? "The reset failed. Ask for a new link.";
    } else {
      return Astro.redirect("/sign-in?reset=1", 303);
    }
  }
}
---
<Desk title="Reset password · Desk">
  <h2>Reset password</h2>
  {error && <p class="error">{error}</p>}
  {token && !linkError ? (
    <form method="post" class="grid" style="max-width: 24rem">
      <input type="hidden" name="token" value={token} />
      <label>New password <input type="password" name="password" required minlength="8" autocomplete="new-password" /></label>
      <label>Again <input type="password" name="again" required minlength="8" autocomplete="new-password" /></label>
      <div><button>Set the password</button></div>
    </form>
  ) : (
    <p><a href="/forgot-password">Ask for a new link</a></p>
  )}
</Desk>
