---
// Asks Neon Auth to email a reset link. The link opens /reset-password with a token. The
// page says the same thing whether or not the address has an account, so it tells nothing
// about who has one.
import Desk from "../layouts/Desk.astro";
import { authFor } from "../lib/auth";

let sent = false;
let error = "";
let email = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = String(form.get("email") ?? "").trim().toLowerCase();
  if (!email) {
    error = "Email is required.";
  } else {
    const { error: e } = await authFor(Astro).requestPasswordReset({
      email,
      redirectTo: `${Astro.url.origin}/reset-password`,
    });
    if (e) {
      error = e.message ?? "The request failed. Try again.";
    } else {
      sent = true;
    }
  }
}
---
<Desk title="Forgot password · Desk">
  <h2>Forgot password</h2>
  {sent ? (
    <p>If that address has an account, an email with a reset link is on its way. The link is valid for a short time.</p>
  ) : (
    <form method="post" class="grid" style="max-width: 24rem">
      {error && <p class="error">{error}</p>}
      <label>Email <input type="email" name="email" value={email} required autocomplete="username" /></label>
      <div><button>Send the reset link</button></div>
    </form>
  )}
  <p><a href="/sign-in">Back to sign in</a></p>
</Desk>
