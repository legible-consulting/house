---
// Jamie's page: the clients table from clients/*/record.md (build time) and the pool's
// count per status (request time). A salesman goes to the pool. A client sees nothing yet.
import Desk from "../layouts/Desk.astro";
import { clients, day } from "../lib/clients";
import { countsByStatus, STATUSES } from "../lib/db";

const user = Astro.locals.user!;
if (user.role === "salesman") return Astro.redirect("/pool", 303);
const counts = user.role === "jamie" ? await countsByStatus() : null;
---
<Desk>
  {user.role === "client" ? (
    <p>Nothing here yet for clients. Your project's page comes in a later wave.</p>
  ) : (
    <>
      <h2>Pool</h2>
      <ul class="counts">
        {STATUSES.map((s) => <li><b>{counts![s]}</b>{s}</li>)}
      </ul>
      <h2>Clients</h2>
      <div class="wrap">
        <table>
          <thead>
            <tr><th>Client</th><th>Stage</th><th>Kind</th><th>Tier</th><th>Next action</th><th>Deadline</th><th>Repo</th></tr>
          </thead>
          <tbody>
            {clients.map((c) => (
              <tr>
                <td>{c.name}</td>
                <td>{c.stage}</td>
                <td>{c.kind ?? ""}</td>
                <td>{c.tier ?? ""}</td>
                <td>{c.next_action ?? ""}</td>
                <td>{day(c.deadline)}</td>
                <td>{c.repo ?? ""}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted">{clients.length} clients</p>
    </>
  )}
</Desk>
