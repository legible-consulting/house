# Names only. The values live in the Vercel project legible-desk (team kodominio), never in
# git. The app reads them from the environment at request time.
DATABASE_URL=<set by the Neon integration when the database is connected to the project>
NEON_AUTH_BASE_URL=<Neon console, project legible-desk, Auth tab, the Auth URL with its path>
NEON_AUTH_COOKIE_SECRET=<output of: openssl rand -base64 32>
DESK_PAT=<fine-grained GitHub token, legible-consulting/house only, Contents, Pull requests and Actions read and write>
ESTATE_PAT=<fine-grained GitHub token, resource owner k0d0minio, Contents, Actions, Metadata, Commit statuses and Pull requests read. Pull requests read and write when Jamie ticks gates from the desk>
ESTATE_PAT_SUSTENTUS=<fine-grained GitHub token, resource owner sustentus, the same permissions as ESTATE_PAT>
POOL_TOKEN=<output of: openssl rand -hex 32. The Vercel project portfolio holds the same value as DESK_POOL_TOKEN; its contact form posts to /api/pool with it>
RESEND_API_KEY=<Resend, the account that holds the domain mail.jamienisbet.com: an API key for the desk, Sending access. lib/mail.ts mails Jamie with it>
