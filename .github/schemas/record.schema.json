{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legible-consulting/house/.github/schemas/record.schema.json",
  "title": "clients/<slug>/record.md frontmatter",
  "description": "clients/CONTEXT.md owns these values: stage, kind, public.",
  "type": "object",
  "properties": {
    "stage": {
      "enum": [
        "prospect",
        "research",
        "proposal",
        "agreement",
        "kickoff",
        "build",
        "handover",
        "after",
        "lost"
      ]
    },
    "kind": {
      "enum": [null, "", "build", "retainer", "role", "training"]
    },
    "public": {
      "enum": [null, "", "named", "anonymous", "none"]
    },
    "deadline": {
      "type": ["string", "null"],
      "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
    },
    "repo": {
      "type": ["string", "null"],
      "pattern": "^$|^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    }
  },
  "required": ["stage"]
}
