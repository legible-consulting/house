{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legible-consulting/house/.github/schemas/estate.schema.json",
  "title": "desk/estate/drift-<date>.md frontmatter",
  "description": "conformance/CONTEXT.md owns this shape.",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "kind": { "const": "estate" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "blueprint": { "type": "string", "minLength": 1 },
    "drifted": { "type": "integer", "minimum": 0 }
  },
  "required": ["title", "kind", "date", "blueprint", "drifted"]
}
