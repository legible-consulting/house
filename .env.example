# ===== GitHub Actions: secrets ================================================================

# Per repository. No organisation secret, no environment-scoped secret (the GitHub environments
# Production, Preview and uat hold none). GITHUB_TOKEN is Actions' own and is never set.
# house, blueprint and site-proof hold no secret.

# --- Set today. ---
# Production's connection string, read by the migration workflow only (db-migrate.yml today;
# promote.yml once a repo takes the blueprint's UAT shape). k0d0minio/berceo, agorasim, vinecliff,
# jamienisbet. The same string as the Vercel production DATABASE_URL: a password reset touches both.
DATABASE_URL=
# A Neon API key for the Kodominio organisation. neon-cleanup.yaml deletes a pull request's Neon
# branches with it. berceo, agorasim. The blueprint's uat-db.sh reads the same name from the shell.
NEON_API_KEY=
# The scheduled routes' bearer, the same value as the Vercel CRON_SECRET. berceo: the workflows
# avis-invitations.yml, demandes-digest.yml and gardes-rappel.yml call the routes with it.
CRON_SECRET=
# The kodominio team's Vercel token under its legacy name. berceo, agorasim. The blueprint reads
# VERCEL_TOKEN. One token, two names: see VERCEL_TOKEN below.
VERCEL_TOKEN_KODOMINIO=
# Slack bot token (xoxb-..., chat:write); release.yaml posts the release with it. remi-ai. berceo's
# and agorasim's release.yaml read the same name, unset there, so their post is skipped.
SLACK_BOT_TOKEN=

# --- Wanted by the blueprint (v0.7.0 promote.yml) and set nowhere yet. ---
# The one Vercel token name. berceo and agorasim take it when they take promote.yml; then the
# legacy name above goes.
VERCEL_TOKEN=

# --- Read by a workflow on main and set nowhere. ---
# agorasim db-migrate.yml seeds the first owner account with them.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=
ADMIN_SEED_PASSWORD=
# berceo and agorasim release.yaml mail the release with it.
RESEND_API_KEY=
# remi-ai quality.yaml: Turborepo remote cache.
TURBO_TOKEN=


# ===== GitHub Actions: variables ==============================================================

# Per repository. No organisation variable. Only remi-ai holds any today.

# --- Set today. ---
# Slack channel id (C...) release.yaml posts to after every merge. remi-ai. berceo's and agorasim's
# release.yaml read the same name, unset there.
SLACK_ANNOUNCE_CHANNEL_ID=
# Slack channel id kept for an alert post. remi-ai. Nothing reads it today.
SLACK_ALERTS_CHANNEL_ID=

# --- Wanted by the blueprint, being set on berceo and agorasim on 2026-10-23. ---
# The Vercel team's slug: kodominio. promote.yml, rollback.sh.
VERCEL_TEAM=
# The Neon project's id. neon-cleanup.yml, uat-db.sh. The same id the Neon set carries on Vercel
# and berceo's and agorasim's .icm/project.json carry as database.neon.project_id.
NEON_PROJECT_ID=
# The Vercel project's name, only when it differs from the repository's. Needed by none today.
VERCEL_PROJECT=

# --- Read by a workflow on main and set nowhere. ---
# berceo and agorasim release.yaml: the release mail's sender and recipients.
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
# remi-ai quality.yaml: the Turborepo team slug.
TURBO_TEAM=


# ===== Local shell (Jamie's machine) ==========================================================

# ~/.zshrc exports one Vercel token per team, as literal values. The legacy estate scripts read
# the kodominio one by the name .icm/project.json gives in deploy.token_env (berceo, agorasim,
# jamienisbet). remi-ai's catalogue says nothing reads the remi21 one today.
VERCEL_TOKEN_KODOMINIO=
VERCEL_TOKEN_REMI21=
VERCEL_TOKEN_SUSTENTUS=

# Not exported today. The blueprint's scripts (uat-db.sh, promote.sh, rollback.sh) and the
# vercel-env-hydrate.sh hook read these from the shell. Set VERCEL_TOKEN from the team's export:
# VERCEL_TOKEN="$VERCEL_TOKEN_KODOMINIO" .icm/scripts/uat-db.sh status
VERCEL_TOKEN=
VERCEL_TEAM=
VERCEL_PROJECT=
NEON_API_KEY=
NEON_PROJECT_ID=
# The custom environment's slug and the UAT branch's name; `uat` when unset.
UAT_ENVIRONMENT=
UAT_DB_BRANCH=
# gh is logged in on this machine, so GH_TOKEN is unset. jamienisbet's env-check.sh reads GH_TOKEN
# and GITHUB_TOKEN when no login exists.
GH_TOKEN=

# Local .env files in the two lanes (core/stack.md Layout), names only, read 2026-10-23:
#   Apps/projects/berceo/.env.local: the Neon set, CRON_SECRET, EMAIL_FROM, NEON_AUTH_COOKIE_SECRET,
#     RESEND_API_KEY and VERCEL_OIDC_TOKEN, pulled from Vercel.
#   Apps/projects/vinecliff/.env.local: VERCEL_OIDC_TOKEN only (vercel-env.sh pull, 2026-09-08).
#   legible-consulting/projects/jamienisbet/.env.local and packages/.env.local: the Neon set
#     (the shared biz database) and VERCEL_OIDC_TOKEN.
#   jamienisbet/websites/{portfolio,admin-dashboard,sellers-site}/.env.local and their
#     .vercel/.env.development.local: VERCEL_OIDC_TOKEN only.
#   agorasim, remi-ai, site-proof: no local .env file. ~/.claude: none.
#   Nineteen legacy clones under Apps/projects and sustentus hold thirty more .env.local files;
#     they are not estate (desk/mani.yaml) and their names are not listed here.
# Written by `vercel env pull`: a short-lived OIDC token for the CLI. Not a project variable.
VERCEL_OIDC_TOKEN=


# ===== Cloud session (the `legible` environment) ==============================================

# The environment carries no variable and no network secret (core/stack.md, Cloud environment).
# The house hooks read CLAUDE_PROJECT_DIR, which Claude Code sets. The names below are what a repo
# would read if the environment dialog set them.

# The blueprint's shell names, for a session that runs uat-db.sh, promote.sh or rollback.sh.
VERCEL_TOKEN=
VERCEL_TEAM=
NEON_API_KEY=
NEON_PROJECT_ID=
# jamienisbet's pipeline requires it (.icm/project.json required_env): gh without a login.
GH_TOKEN=
# jamienisbet's .claude/hooks/vercel-env-hydrate.sh links the clone to its Vercel project and
# pulls .env.local at session start when VERCEL_TOKEN is set. The project name when the repo maps
# to several; the target (production by default); 0 to switch the hook off; seconds before a
# re-pull. Dormant today: session-start.sh, which calls the hook, is not registered in the repo's
# .claude/settings.json.
VERCEL_PROJECT=
VERCEL_ENV_TARGET=
VERCEL_ENV_HYDRATE=
VERCEL_ENV_MAX_AGE=
