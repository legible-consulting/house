# ===== GitHub Actions: secrets ================================================================

# Per repository. Read 2026-10-28: gh secret list, and the workflows on each repo's main. No
# organisation secret, no environment-scoped secret (the GitHub environments hold none).
# GITHUB_TOKEN is Actions' own and is never set. house, blueprint and .github hold no secret.
# The blueprint v1.0.0 renders neon-cleanup.yml and preview-db.yml on a neon build and
# promote.yml on a UAT build. berceo, agorasim, vinecliff and remi-ai are neon UAT builds.
# jamienisbet (database: none) has no workflow that reads a secret.
# .icm/intake/triage/neon-workflow-secrets.md tracks the names that are missing.

# --- Set today. ---
# Production's direct connection string. promote.yml's migration reads it: berceo, agorasim,
# vinecliff. vinecliff's db-migrate.yml reads it too. The same database as the Vercel production
# DATABASE_URL: a password reset touches both. jamienisbet holds one that no workflow reads.
DATABASE_URL=
# A Neon API key for the organisation that holds the repo's Neon project. preview-db.yml makes a
# pull request's Neon branch with it, and neon-cleanup.yml deletes the branch when the pull
# request closes. berceo, agorasim. The blueprint's lib/neon.sh reads the same name from the shell.
NEON_API_KEY=
# A Vercel token for the repo's team. preview-db.yml and neon-cleanup.yml write and delete a pull
# request's preview DATABASE_URL with it. promote.yml promotes the staged production build with it.
# berceo (set 2026-10-27).
VERCEL_TOKEN=
# The scheduled routes' bearer, the same value as the Vercel CRON_SECRET. berceo: the workflows
# avis-invitations.yml, demandes-digest.yml and gardes-rappel.yml call the routes with it.
CRON_SECRET=
# The kodominio team's Vercel token under its legacy name. berceo, agorasim. No workflow reads it.
VERCEL_TOKEN_KODOMINIO=
# Slack bot token (xoxb-...). remi-ai. No workflow reads it.
SLACK_BOT_TOKEN=

# --- Read by a workflow on main and set nowhere. Every pull request's neon-cleanup.yml and
# preview-db.yml fail until they are set. ---
# agorasim, vinecliff: a kodominio token. remi-ai: a remi21 token, because its Vercel projects are
# on the team remi21.
VERCEL_TOKEN=
# vinecliff, remi-ai.
NEON_API_KEY=
# remi-ai: promote.yml's migration.
DATABASE_URL=


# ===== GitHub Actions: variables ==============================================================

# Per repository. Read 2026-10-28: gh variable list, and the workflows on each repo's main. No
# organisation variable.

# --- Set today. ---
# The Vercel team's slug. preview-db.yml, neon-cleanup.yml, promote.yml, rollback.sh. berceo,
# agorasim: kodominio.
VERCEL_TEAM=
# The id of the Neon project that holds the base. preview-db.yml, neon-cleanup.yml, lib/neon.sh.
# berceo, agorasim. The same id the Neon set carries on Vercel. An identifier, not a secret.
NEON_PROJECT_ID=
# Slack channel ids. remi-ai. No workflow reads them.
SLACK_ANNOUNCE_CHANNEL_ID=
SLACK_ALERTS_CHANNEL_ID=

# --- Read by a workflow on main and set nowhere. ---
# vinecliff: kodominio. remi-ai: remi21.
VERCEL_TEAM=
# vinecliff, remi-ai.
NEON_PROJECT_ID=
# The Vercel project's name, only when it differs from the repository's name. The workflows use
# the repository's name when it is unset. berceo, agorasim and vinecliff need none. remi-ai needs
# one: its six projects (admin, app, demo, documentation, marketing, support) have other names.
VERCEL_PROJECT=


# ===== Local shell (Jamie's machine) ==========================================================

# ~/.zshrc exports one Vercel token per team, as literal values (names read 2026-10-28). No script
# on an estate repo's main reads these names. remi-ai's .icm/docs/ENV.md says the same of the
# remi21 one.
VERCEL_TOKEN_KODOMINIO=
VERCEL_TOKEN_REMI21=
VERCEL_TOKEN_SUSTENTUS=

# Not exported. The blueprint's scripts (.icm/scripts/preview-db.sh, promote.sh and rollback.sh,
# through lib/vercel.sh and lib/neon.sh) read these from the shell. Set VERCEL_TOKEN from the
# team's export:
# VERCEL_TOKEN="$VERCEL_TOKEN_KODOMINIO" .icm/scripts/promote.sh status
VERCEL_TOKEN=
# The team's slug. Unset means the personal scope.
VERCEL_TEAM=
# The Vercel project's name. The repository's name when unset.
VERCEL_PROJECT=
NEON_API_KEY=
NEON_PROJECT_ID=
# The custom environment's slug. `uat` when unset.
UAT_ENVIRONMENT=

# Local .env files in the two lanes (core/stack.md Layout), names only, read 2026-10-23:
#   legible-consulting/projects/berceo/.env.local: the Neon set, CRON_SECRET, EMAIL_FROM, NEON_AUTH_COOKIE_SECRET,
#     RESEND_API_KEY and VERCEL_OIDC_TOKEN, pulled from Vercel.
#   legible-consulting/projects/vinecliff/.env.local: VERCEL_OIDC_TOKEN only (vercel-env.sh pull, 2026-09-08).
#   legible-consulting/projects/jamienisbet/.env.local and packages/.env.local: the Neon set
#     (the shared biz database) and VERCEL_OIDC_TOKEN.
#   jamienisbet/websites/{portfolio,admin-dashboard,sellers-site}/.env.local and their
#     .vercel/.env.development.local: VERCEL_OIDC_TOKEN only.
#   agorasim, remi-ai: no local .env file. ~/.claude: none.
#   Nineteen legacy clones under Apps/projects and sustentus hold thirty more .env.local files;
#     they are not estate (desk/mani.yaml) and their names are not listed here.
# Written by `vercel env pull`: a short-lived OIDC token for the CLI. Not a project variable.
VERCEL_OIDC_TOKEN=


# ===== Cloud session (the `legible` environment) ==============================================

# The environment carries no variable and no network secret (core/stack.md, Cloud environment).
# The house hooks read CLAUDE_PROJECT_DIR, which Claude Code sets. The names below are what a repo
# would read if the environment dialog set them: the blueprint's shell names, for a session that
# runs preview-db.sh, promote.sh or rollback.sh.
VERCEL_TOKEN=
VERCEL_TEAM=
VERCEL_PROJECT=
NEON_API_KEY=
NEON_PROJECT_ID=
